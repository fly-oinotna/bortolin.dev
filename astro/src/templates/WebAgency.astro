---
// SERVIZI › PER LE WEB AGENCY — contenuti in Keystatic → "Per le web agency" (un gruppo per sezione, SEO in fondo).
// Sezioni proprie della pagina qui sotto; quelle comuni (metodo, recensioni, offerta, FAQ, blog, contatti) da src/components/sections/.
// Il pannello progetti dell'hero è animato da main.js ([data-board-demo]).
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, pageOffer } from '../lib/content';
import { rich } from '../lib/rich';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';
import type { IconName } from '../lib/icons';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('webAgency', lang);
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/sviluppatore-freelance-per-web-agency/');
const offer = await pageOffer(g, p.offer);

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['collab', 'pricing', 'services', 'tech', 'method', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, collab, pricing: pr, services: sv, tech } = p;
const [main, ...others] = sv.items;
const lastEx = pr.example.length - 1;
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO (pannello progetti in white label) -->
  <section class="overflow-hidden bg-gray-100 pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase">{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-primary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={g.settings.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip bg-white"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>
        <figure class="relative mx-auto w-full max-w-xl" data-board-demo data-todo={h.statusTodo} data-doing={h.statusDoing} data-done={h.statusDone}>
          <div aria-hidden="true" class="absolute -top-12 -right-12 h-64 w-64 rounded-full bg-bd-green/40"></div>
          <div class="relative rounded-3xl border-[3px] border-black bg-white p-5 shadow-2xl md:p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2.5"><span class="grid h-10 w-10 place-items-center rounded-xl border-2 border-dashed border-gray-400 text-[9px] leading-tight font-bold text-gray-500 text-center" set:html={(h.boardLogo ?? '').split('\n').map((x) => x.replace(/[<>&]/g, '')).join('<br>')} /><span><span class="block text-xs font-semibold text-gray-600 uppercase">{h.boardLabel}</span><span class="block font-bold text-black">{h.boardTitle}</span></span></span>
              {h.boardBadge && <span class="rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green">{h.boardBadge}</span>}
            </div>
            <ul class="mt-5 space-y-2.5">
              {h.tasks.map((tk) => (
                <li data-task="done" class="rounded-2xl border border-gray-200 p-3.5">
                  <div class="flex items-start justify-between gap-3">
                    <span class="min-w-0"><span class="block truncate text-sm font-semibold text-black">{tk.title}</span><span class="block truncate text-xs text-gray-600">{tk.client}</span></span>
                    <span class="shrink-0 text-right"><span class="block text-sm font-extrabold text-black tabular-nums">{tk.price}</span><span class="block text-[10px] font-semibold text-gray-600 uppercase">{h.priceLabel}</span></span>
                  </div>
                  <div class="mt-2.5 flex items-center gap-3">
                    <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-gray-100"><span data-task-bar class="block h-full w-full rounded-full bg-bd-green"></span></span>
                    <span data-task-chip class="inline-flex min-w-[6.5rem] items-center justify-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-bold"><svg data-task-check aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg><span data-task-status>{h.statusDone}</span></span>
                  </div>
                </li>
              ))}
            </ul>
            {h.summaryLabel && <p class="mt-4 flex items-center justify-between rounded-2xl bg-gray-100 px-4 py-3 text-sm"><span class="font-semibold text-black">{h.summaryLabel}</span><span class="text-lg font-extrabold text-black">{h.summaryValue}</span></p>}
          </div>
          {h.caption && <figcaption class="mt-4 text-center text-sm text-gray-600">{h.caption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= COME COLLABORIAMO -->
  <section id="come-collaboriamo" class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('collab')} eyebrow={collab.eyebrow} title={collab.title} text={collab.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {collab.items.map((it, i) => (
          <li class:list={['rounded-3xl p-6', i === 0 ? 'bg-bd-green' : 'bg-gray-100']}>
            <h3 class="text-lg">{it.title}</h3>
            <p class:list={['text-sm', i === 0 && 'text-black']}>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================= PREZZO FISSO -->
  <section id="prezzo-fisso" class="pb-16 md:pb-24">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-10 rounded-3xl bg-black p-6 text-white md:p-10 lg:grid-cols-2 lg:gap-16 lg:p-14">
        <SectionHeading n={n('pricing')} eyebrow={pr.eyebrow} title={pr.title} text={pr.text} dark class="">
          <ul class="mt-6 space-y-3 text-gray-200">
            {pr.points.map((pt) => <li class="flex gap-3"><Icon name="check" size={16} stroke={3} class="mt-0.5 shrink-0 text-bd-green" /><span set:html={rich(pt.text, { strong: 'text-white' })} /></li>)}
          </ul>
        </SectionHeading>
        <div class="rounded-3xl bg-white p-6 text-black md:p-8">
          <p class="text-sm font-bold text-gray-600 uppercase">{pr.exampleLabel}</p>
          <ol class="mt-4 space-y-3">
            {pr.example.map((ex, i) => {
              const last = i === lastEx && lastEx > 0;
              return <li class:list={['flex items-center justify-between gap-4 rounded-2xl p-4', last ? 'bg-bd-green' : 'bg-gray-100']}><span><strong class="block">{ex.title}</strong><span class:list={['text-sm', !last && 'text-gray-600']}>{ex.text}</span></span><span class="text-xl font-extrabold tabular-nums">{ex.value}</span></li>;
            })}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================= I SERVIZI -->
  <section id="servizi-agency" class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('services')} eyebrow={sv.eyebrow} title={sv.title} text={sv.text}>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label={sv.navLabel}>
          {sv.items.map((it) => <li><a class="chip bg-white hover:bg-bd-green" href={`#${it.anchor}`}>{it.short || it.title}</a></li>)}
        </ul>
      </SectionHeading>
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {main && (
          <article id={main.anchor} class="scroll-mt-28 grid grid-cols-1 gap-6 rounded-3xl bg-black p-6 text-white md:p-10 lg:col-span-3 lg:grid-cols-2 lg:gap-12">
            <div>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-bd-green text-black"><Icon name={main.icon as IconName} size={26} /></span>
              {main.label && <p class="mt-5 text-sm font-bold text-bd-green uppercase">{main.label}</p>}
              <h3 class="mt-1 text-2xl text-white lg:text-3xl">{main.title}</h3>
              <p class="text-gray-300">{main.text}</p>
            </div>
            <ul class="grid content-center gap-3 text-gray-200">{main.points.map((pt) => <li class="flex gap-2"><Icon name="check" size={16} stroke={3} class="mt-0.5 shrink-0 text-bd-green" /><span>{pt}</span></li>)}</ul>
          </article>
        )}
        {others.map((it) => (
          <article id={it.anchor} class="scroll-mt-28 flex flex-col rounded-3xl bg-white p-6 md:p-8">
            <div class="flex items-start justify-between gap-3">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-black text-bd-green"><Icon name={it.icon as IconName} size={26} /></span>
              {it.badge && <span class="rounded-full bg-bd-green px-3 py-1 text-xs font-bold text-black">{it.badge}</span>}
            </div>
            <h3 class="mt-5 text-xl">{it.title}</h3>
            <p class="text-sm">{it.text}</p>
            <ul class="mt-4 space-y-2 text-sm text-black">{it.points.map((pt) => <li class="flex gap-2"><Icon name="check" size={16} stroke={3} class="mt-0.5 shrink-0" /><span>{pt}</span></li>)}</ul>
            {it.footer && <p class="mt-auto pt-5 text-xs font-bold text-black uppercase">{it.footer}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================= TECNOLOGIE -->
  <section id="tecnologie" class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('tech')} eyebrow={tech.eyebrow} title={tech.title} text={tech.text} />
      <div class="mt-10 flex flex-col gap-6 rounded-3xl bg-gray-100 p-6 md:p-10">
        {tech.groups.map((gr) => (
          <div class="flex flex-col gap-3 border-b border-gray-200 pb-6 last:border-0 last:pb-0 md:flex-row md:items-center md:gap-8">
            <h3 class="mb-0 w-48 shrink-0 text-sm font-bold text-gray-600 uppercase">{gr.title}</h3>
            <ul class="flex flex-wrap gap-2">
              {gr.items.map((it) => <li class="flex items-center gap-2.5 rounded-full bg-white py-2 pr-4 pl-2.5 shadow-sm"><Img src={it.logo} alt="" class="h-6 w-6" /><span class="text-sm font-semibold text-black">{it.name}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
      {tech.note && <p class="mt-4 text-xs text-gray-600">{tech.note}</p>}
    </div>
  </section>

  <MethodSteps {...p.method} n={n('method')} class="pb-16 md:pb-24" />

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} class="pb-16 md:pb-24" />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
