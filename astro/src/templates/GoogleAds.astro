---
// SERVIZI › GOOGLE ADS — contenuti in Keystatic → "Google Ads" (un gruppo per sezione, SEO in fondo).
// Sezioni proprie della pagina qui sotto; quelle comuni (cosa è incluso, metodo, recensioni, offerta, FAQ, blog, contatti)
// da src/components/sections/. Gli esempi dell'hero cambiano con main.js ([data-serp-demo]).
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import IncludedBox from '../components/sections/IncludedBox.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, pageOffer } from '../lib/content';
import { rich } from '../lib/rich';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';
import type { IconName } from '../lib/icons';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('googleAds', lang);
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/google-ads/');
const offer = await pageOffer(g, p.offer);

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['how', 'types', 'included', 'pricing', 'method', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, how, types, pricing: pr } = p;
const lastHow = how.items.length - 1;
const SHOE = ['#e5e7eb', '#9ca3af', '#99EA48'];
const lines = (a: string, b: string, c: string, d?: string) => `<span class="block h-2.5 ${a} rounded-full bg-gray-200"></span><span class="block h-3.5 ${b} max-w-full rounded-full bg-gray-300"></span><span class="block h-2.5 ${c} rounded-full bg-gray-200"></span>${d ? `<span class="block h-2.5 ${d} rounded-full bg-gray-200"></span>` : ''}`;
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO (risultati di Google con annunci) -->
  <section class="overflow-hidden pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase">{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-secondary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={g.settings.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>
        <figure class="relative mx-auto w-full max-w-xl" data-serp-demo>
          <div aria-hidden="true" class="absolute -top-12 -right-12 h-64 w-64 rounded-full bg-bd-green/40"></div>
          <div class="relative rounded-3xl border-[3px] border-black bg-white p-5 shadow-2xl md:p-6">
            <div class="flex items-center gap-3 rounded-full border-2 border-gray-200 px-4 py-3">
              <Icon name="lens" size={20} stroke={2.5} />
              <span class="min-h-[1.5rem] font-medium text-black" data-serp-query>{h.s1Query}</span>
            </div>
            <div class="mt-5" data-serp-slides>
              <div data-serp-slide data-active data-query={h.s1Query}>
                <div class="rounded-2xl border-2 border-black bg-bd-green/25 p-4">
                  <p class="text-xs font-bold text-black">{h.s1Ad}</p>
                  <div class="mt-1 flex items-center gap-2"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-black text-xs font-bold text-bd-green">{h.s1Letter}</span><span class="leading-tight"><span class="block text-sm font-semibold text-black">{h.s1Name}</span><span class="block text-xs text-gray-600">{h.s1Url}</span></span></div>
                  <p class="mt-2 text-lg leading-snug font-semibold text-black">{h.s1Title}</p>
                  <p class="mt-1 text-sm text-gray-700">{h.s1Text}</p>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    {h.s1Call && <span class="inline-flex items-center gap-1.5 rounded-full bg-black px-3 py-1.5 text-xs font-semibold text-white"><Icon name="phone" size={14} stroke={2.2} />{h.s1Call}</span>}
                    {h.s1Chips.map((c) => <span class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-black">{c}</span>)}
                  </div>
                </div>
                <div class="mt-4 space-y-2 px-1" aria-hidden="true" set:html={lines('w-28', 'w-64', 'w-72 max-w-full')} />
                <div class="mt-5 space-y-2 px-1" aria-hidden="true" set:html={lines('w-32', 'w-60', 'w-full', 'w-2/3')} />
              </div>
              <div data-serp-slide data-query={h.s2Query}>
                <div class="rounded-2xl border-2 border-black bg-bd-green/25 p-4">
                  <p class="text-xs font-bold text-black">{h.s2Ad}</p>
                  <div class="mt-1 flex items-center gap-2"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-black text-xs font-bold text-bd-green">{h.s2Letter}</span><span class="leading-tight"><span class="block text-sm font-semibold text-black">{h.s2Name}</span><span class="block text-xs text-gray-600">{h.s2Url}</span></span></div>
                  <p class="mt-2 text-lg leading-snug font-semibold text-black">{h.s2Title}</p>
                  <p class="mt-1 text-sm text-gray-700">{h.s2Text}</p>
                  {h.s2Place && <p class="mt-2 flex items-center gap-1.5 text-xs text-black"><Icon name="pin" size={14} stroke={2.2} /><strong>{h.s2Place}</strong>{h.s2Hours && ` · ${h.s2Hours}`}</p>}
                  <div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs font-semibold text-black">
                    {h.s2Tiles.map((c) => <span class="rounded-xl bg-white px-2 py-2">{c}</span>)}
                  </div>
                </div>
                <div class="mt-4 space-y-2 px-1" aria-hidden="true" set:html={lines('w-24', 'w-56', 'w-64 max-w-full')} />
                <div class="mt-5 space-y-2 px-1" aria-hidden="true" set:html={lines('w-32', 'w-60', 'w-full', 'w-2/3')} />
              </div>
              <div data-serp-slide data-query={h.s3Query}>
                <div class="rounded-2xl border-2 border-black bg-white p-4">
                  <p class="text-xs font-bold text-black">{h.s3Ad}</p>
                  <ul class="mt-3 grid grid-cols-3 gap-2">
                    {h.s3Products.map((pr, i) => (
                      <li class="rounded-2xl border border-gray-200 p-2.5">
                        <span class="grid aspect-square place-items-center rounded-xl bg-gray-100"><svg aria-hidden="true" width="56" height="56" viewBox="0 0 64 64"><path d="M10 40c0-8 2-18 4-24h12c0 6 2 10 8 13l14 5c5 2 8 5 8 9v3H10z" fill={SHOE[i % 3]} stroke="#000" stroke-width="2.5" stroke-linejoin="round"/><path d="M10 47h46v4H10z" fill="#000"/><path d="M20 24h8M21 30h9" stroke="#000" stroke-width="2" stroke-linecap="round"/></svg></span>
                        <p class="mt-2 text-xs leading-tight font-semibold text-black">{pr.name}</p>
                        <p class="mt-1 text-sm font-extrabold text-black">{pr.price}</p>
                        <p class="text-[11px] text-gray-600">{pr.shop}</p>
                        {pr.rating && <p class="mt-0.5 flex items-center gap-0.5 text-[11px] text-black"><Icon name="star" size={12} />{pr.rating}</p>}
                      </li>
                    ))}
                  </ul>
                  {h.s3Note && <p class="mt-3 text-xs text-gray-700">{h.s3Note}</p>}
                </div>
              </div>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2" role="group" aria-label={h.demoLabel}>
            {[h.s1Tab, h.s2Tab, h.s3Tab].map((tab, i) => <button type="button" data-serp-tab aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-gray-200">{tab}</button>)}
          </div>
          {h.demoCaption && <figcaption class="mt-3 text-center text-sm text-gray-600">{h.demoCaption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= COME FUNZIONA -->
  <section id="come-funziona" class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('how')} eyebrow={how.eyebrow} title={how.title} text={how.text} />
      <ol class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-6">
        {how.items.map((it, i) => {
          const green = i === lastHow && lastHow > 0;
          return (
            <li class:list={['rounded-3xl p-6 md:p-8', green ? 'bg-bd-green' : 'bg-white']}>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-black text-bd-green"><Icon name={it.icon as IconName} size={28} stroke={1.8} /></span>
              <h3 class="mt-5">{it.title}</h3>
              <p class:list={['text-sm', green && 'text-black']}>{it.text}</p>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================================================= TIPI DI CAMPAGNA -->
  <section class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('types')} eyebrow={types.eyebrow} title={types.title} text={types.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
        {types.items.map((it) => (
          <li class:list={['flex flex-col rounded-3xl p-6', it.highlight ? 'bg-black text-white' : 'bg-gray-100']}>
            <h3 class:list={['text-lg', it.highlight && 'text-bd-green']}>{it.title}</h3>
            <p class:list={['text-sm', it.highlight && 'text-gray-300']}>{it.text}</p>
            {it.ideal && <p class:list={['mt-auto pt-4 text-xs font-semibold uppercase', it.highlight ? 'text-gray-400' : 'text-gray-600']}>{it.ideal}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <IncludedBox {...p.included} n={n('included')} />

  <!-- ================================================= PREZZO FISSO -->
  <section class="bg-gray-100 py-16 md:py-24">
    <div class="container grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading n={n('pricing')} eyebrow={pr.eyebrow} title={pr.title} text={pr.text} class="" />
        <ul class="mt-6 space-y-3">
          {pr.points.map((pt) => <li class="flex gap-3"><Icon name="check" size={18} stroke={3} class="mt-0.5 shrink-0" /><span set:html={rich(pt.text)} /></li>)}
        </ul>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border-2 border-dashed border-gray-300 bg-white p-6">
          <p class="text-sm font-bold text-gray-600 uppercase">{pr.otherLabel}</p>
          <p class="mt-3 text-3xl font-extrabold text-gray-400">{pr.otherValue}</p>
          <p class="mt-2 text-sm">{pr.otherText}</p>
        </div>
        <div class="rounded-3xl bg-black p-6 text-white">
          <p class="text-sm font-bold text-bd-green uppercase">{pr.mineLabel}</p>
          <p class="mt-3 text-3xl font-extrabold text-white">{pr.mineValue}</p>
          <p class="mt-2 text-sm text-gray-300">{pr.mineText}</p>
        </div>
        {pr.note && <p class="text-xs text-gray-600 sm:col-span-2">{pr.note}</p>}
      </div>
    </div>
  </section>

  <MethodSteps {...p.method} n={n('method')} />

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} class="pb-16 md:pb-24" />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
