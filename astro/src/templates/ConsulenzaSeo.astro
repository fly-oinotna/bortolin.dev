---
// SERVIZI › CONSULENZA SEO — contenuti in Keystatic → "Consulenza SEO" (un gruppo per sezione, SEO in fondo).
// Sezioni proprie della pagina qui sotto; quelle comuni (recensioni, offerta, FAQ, blog, contatti) da src/components/sections/.
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, pageOffer } from '../lib/content';
import { rich } from '../lib/rich';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';
import type { IconName } from '../lib/icons';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('consulenzaSeo', lang);
const s = g.settings;
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/consulenza-seo/');
const offer = await pageOffer(g, p.offer);

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['steps', 'pillars', 'local', 'ai', 'formats', 'method', 'promises', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, steps, pillars, local, ai, formats, method: me, promises } = p;
const PRIORITY: Record<string, { label: string; cls: string }> = {
  alta: { label: 'Alta', cls: 'bg-black text-white' },
  media: { label: 'Media', cls: 'bg-bd-green text-black' },
  bassa: { label: 'Bassa', cls: 'bg-gray-200 text-black' },
};
const lastStep = steps.items.length - 1;
const lastMe = me.steps.length - 1;
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO (con finta pagina di risultati) -->
  <section class="overflow-hidden bg-gray-100 pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase">{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-secondary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={s.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip bg-white"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>

        <div class="relative mx-auto w-full max-w-xl" aria-hidden="true">
          <div class="absolute -top-12 -right-12 h-64 w-64 rounded-full bg-bd-green/40"></div>
          <div class="relative rounded-3xl border-[3px] border-black bg-white p-5 shadow-2xl md:p-6">
            <div class="flex items-center gap-3 rounded-full border-2 border-gray-200 px-4 py-3">
              <Icon name="lens" size={20} stroke={2.5} />
              <span class="font-medium text-black" data-typing>{h.serpQuery}</span>
            </div>
            <div class="mt-5 rounded-2xl bg-gray-100 p-4">
              <p class="flex items-center gap-1.5 text-xs font-bold text-black uppercase"><Icon name="sparkle" size={14} />{h.serpAiTitle}</p>
              <p class="mt-2 text-sm text-gray-700" set:html={rich(h.serpAiText, { strong: 'rounded bg-bd-green px-1 font-semibold text-black' })} />
            </div>
            <div class="relative mt-4 rounded-2xl border-2 border-black bg-bd-green/30 p-4">
              {h.serpRank && <span class="absolute -top-3 -right-3 grid h-11 w-11 place-items-center rounded-full bg-black text-sm font-extrabold text-bd-green">{h.serpRank}</span>}
              <p class="text-xs text-gray-700">{h.serpUrl}</p>
              <p class="mt-1 text-lg leading-snug font-semibold text-black">{h.serpTitle}</p>
              <p class="mt-1 flex items-center gap-1 text-xs text-gray-700"><span class="text-black">★★★★★</span> {h.serpMeta}</p>
            </div>
            <div class="mt-4 space-y-2 rounded-2xl p-4">
              <span class="block h-2.5 w-28 rounded-full bg-gray-200"></span>
              <span class="block h-3.5 w-64 max-w-full rounded-full bg-gray-300"></span>
              <span class="block h-2.5 w-72 max-w-full rounded-full bg-gray-200"></span>
            </div>
            <div class="space-y-2 rounded-2xl px-4 pb-2">
              <span class="block h-2.5 w-24 rounded-full bg-gray-200"></span>
              <span class="block h-3.5 w-56 max-w-full rounded-full bg-gray-300"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================= LA SEO IN 3 PASSAGGI -->
  <section id="come-funziona" class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('steps')} eyebrow={steps.eyebrow} title={steps.title} text={steps.text} />
      <ol class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-6" data-draw>
        {steps.items.map((it, i) => {
          const green = i === lastStep && lastStep > 0;
          return (
            <li class:list={['relative rounded-3xl p-6 md:p-8', green ? 'bg-bd-green' : 'bg-gray-100']} style={`--d:${i * 150}ms`}>
              <span class="draw-badge grid h-16 w-16 place-items-center rounded-2xl bg-black text-bd-green"><Icon name={it.icon as IconName} size={32} stroke={1.8} draw /></span>
              <p class:list={['mt-6 text-sm font-bold uppercase', green ? 'text-black' : 'text-gray-600']}>{steps.stepLabel} {i + 1}</p>
              <h3>{it.title}</h3>
              <p class:list={[green && 'text-black']}>{it.text}</p>
              <Rich value={it.work} class="mt-4 rounded-2xl bg-white p-3 text-sm" />
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================================================= I TRE PILASTRI (schede) -->
  <section class="bg-black py-16 text-white md:py-24">
    <div class="container">
      <SectionHeading n={n('pillars')} eyebrow={pillars.eyebrow} title={pillars.title} dark />
      <div class="mt-10" data-tabs>
        <div role="tablist" aria-label={pillars.tabsLabel} class="inline-flex flex-wrap gap-2 rounded-full bg-white/10 p-1.5">
          {pillars.items.map((it, i) => (
            <button type="button" role="tab" id={`tab-pilastro-${i + 1}`} aria-controls={`pan-pilastro-${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} class="rounded-full px-5 py-2.5 font-semibold text-white transition-colors hover:text-bd-green">{it.tab}</button>
          ))}
        </div>
        {pillars.items.map((it, i) => (
          <div id={`pan-pilastro-${i + 1}`} role="tabpanel" aria-labelledby={`tab-pilastro-${i + 1}`} tabindex="0" class="mt-6 grid grid-cols-1 gap-8 rounded-3xl bg-white/10 p-6 md:p-10 lg:grid-cols-2">
            <div>
              <h3 class="text-2xl text-bd-green">{it.title}</h3>
              <Rich value={it.text} class="text-gray-300" strong="text-white" />
            </div>
            <ul class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
              {it.points.map((pt) => <li class="rounded-2xl bg-black/40 p-4"><strong class="block text-white">{pt.title}</strong><span class="text-gray-300">{pt.text}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================= SEO LOCALE -->
  <section class="py-16 md:py-24">
    <div class="container grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <Img src={local.image} alt={local.imageAlt} class="float-soft mx-auto w-full max-w-lg" />
      <div>
        <SectionHeading n={n('local')} eyebrow={local.eyebrow} title={local.title} text={local.text} class="" />
        <ul class="mt-6 space-y-3">
          {local.points.map((pt, i) => (
            <li class="flex gap-3 rounded-2xl bg-gray-100 p-4"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-bd-green text-sm font-bold text-black">{i + 1}</span><span set:html={rich(pt.text)} /></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================================================= VISIBILITÀ NELLE AI -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-10 rounded-3xl bg-gray-100 p-6 md:p-10 lg:grid-cols-5 lg:gap-12 lg:p-14">
        <div class="lg:col-span-3">
          <SectionHeading n={n('ai')} eyebrow={ai.eyebrow} title={ai.title} class="" />
          <Rich value={ai.text} class="text-black" />
          <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {ai.cards.map((c) => <li class="rounded-2xl bg-black p-4 text-sm text-gray-200"><strong class="block text-bd-green">{c.title}</strong>{c.text}</li>)}
          </ul>
          <Rich value={ai.note} class="mt-6 text-sm text-black" />
        </div>
        <Img src={ai.image} alt={ai.imageAlt} class="float-soft mx-auto w-full max-w-md lg:col-span-2" />
      </div>
    </div>
  </section>

  <!-- ================================================= FORMATI DI COLLABORAZIONE -->
  <section id="formati" class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('formats')} eyebrow={formats.eyebrow} title={formats.title} text={formats.text} />
      <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-6">
        {formats.items.map((f) => {
          const dark = f.highlight;
          return (
            <article class:list={['relative flex flex-col rounded-3xl p-6 md:p-8', dark ? 'bg-black text-white' : 'bg-white']}>
              {dark && f.badge && <span class="absolute -top-3 right-6 rounded-full bg-bd-green px-3 py-1 text-xs font-bold text-black uppercase">{f.badge}</span>}
              <p class:list={['text-sm font-bold uppercase', dark ? 'text-gray-400' : 'text-gray-600']}>{f.label}</p>
              <h3 class:list={['mt-2 text-2xl', dark && 'text-bd-green']}>{f.title}</h3>
              <p class:list={[dark && 'text-gray-300']}>{f.text}</p>
              <ul class:list={['mt-5 space-y-2 text-sm', dark && 'text-gray-200']}>
                {f.points.map((pt) => <li class="flex gap-2"><Icon name="check" size={18} stroke={3} class:list={['mt-0.5 shrink-0', dark && 'text-bd-green']} />{pt}</li>)}
              </ul>
              <Rich value={f.note} class:list={['mt-auto pt-6 text-sm', dark && 'text-gray-300']} strong={dark ? 'text-white' : 'text-black'} />
              {f.ctaLabel && <div class="mt-auto pt-6"><a href={href(f.ctaLink)} class={dark ? 'btn-primary' : 'btn-secondary'}>{f.ctaLabel}</a></div>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ================================================= METODO + ESEMPIO DI REPORT -->
  <section id="metodo-seo" class="py-16 md:py-24">
    <div class="container grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading n={n('method')} eyebrow={me.eyebrow} title={me.title} class="" />
        <ol class="relative mt-8 ml-[1.125rem] space-y-8 border-l-2 border-dashed border-black/20 pl-8">
          {me.steps.map((st, i) => {
            const green = i === 0 || i === lastMe;
            return (
              <li class="relative">
                <span class:list={['absolute top-0 -left-[3.19rem] grid h-9 w-9 place-items-center rounded-full text-sm font-bold ring-4 ring-white', green ? 'bg-bd-green text-black' : 'bg-black text-bd-green']}>{i + 1}</span>
                <h3 class="mb-1 text-lg">{st.title}</h3>
                <p class="text-sm">{st.text}</p>
              </li>
            );
          })}
        </ol>
        {me.ctaLabel && <a href={href(me.ctaLink)} class="btn-secondary mt-10">{me.ctaLabel}</a>}
      </div>
      {me.reportItems.length > 0 && (
        <figure class="self-start rounded-3xl border-[3px] border-black bg-white p-6 shadow-2xl md:p-8 lg:sticky lg:top-28">
          <figcaption class="flex items-center justify-between gap-4">
            <span>
              <span class="block text-xs font-bold text-gray-600 uppercase">{me.reportEyebrow}</span>
              <span class="block text-xl font-bold text-black">{me.reportTitle}</span>
            </span>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-black text-bd-green" aria-hidden="true"><Icon name="file" size={24} /></span>
          </figcaption>
          <ul class="mt-6 divide-y divide-gray-200">
            {me.reportItems.map((it) => {
              const pr = PRIORITY[it.priority] ?? PRIORITY.media;
              return <li class="flex items-start justify-between gap-4 py-3"><span class="text-sm text-black">{it.text}</span><span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold', pr.cls]}>{pr.label}</span></li>;
            })}
          </ul>
          <Rich value={me.reportBox} class="mt-4 rounded-2xl bg-gray-100 p-4 text-sm" />
          {me.reportNote && <p class="mt-3 text-xs text-gray-600">{me.reportNote}</p>}
        </figure>
      )}
    </div>
  </section>

  <!-- ================================================= PROMESSE CHE NON TI FARÒ -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class="rounded-3xl bg-black p-6 md:p-10 lg:p-14">
        <SectionHeading n={n('promises')} eyebrow={promises.eyebrow} title={promises.title} text={promises.text} dark class="max-w-3xl" />
        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
          {promises.items.map((it) => (
            <div class="rounded-2xl bg-white/10 p-5">
              <p class="text-lg font-semibold text-gray-400 line-through decoration-bd-green decoration-2">{it.promise}</p>
              <Rich value={it.instead} class="mt-3 text-sm text-gray-200" strong="text-bd-green" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} class="pb-16 md:pb-24" />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
