---
// SERVIZI › META ADS — contenuti in Keystatic → "Meta Ads" (un gruppo per sezione, SEO in fondo).
// Sezioni proprie della pagina qui sotto; quelle comuni (cosa è incluso, metodo, recensioni, offerta, FAQ, blog, contatti)
// da src/components/sections/. Il feed dell'hero è animato da main.js ([data-feed-demo]).
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import IncludedBox from '../components/sections/IncludedBox.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, pageOffer } from '../lib/content';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';
import type { IconName } from '../lib/icons';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('metaAds', lang);
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/meta-ads/');
const offer = await pageOffer(g, p.offer);

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['platforms', 'formats', 'results', 'included', 'method', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, platforms: pl, formats: fo, results: re } = p;
const IG = 'bg-[conic-gradient(from_200deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5,#feda75)]';
const LOGO = { meta: '/src/assets/images/social/meta.svg', facebook: '/src/assets/images/social/facebook.svg', instagram: '/src/assets/images/social/instagram.svg' };
// colori delle storie e delle bottiglie del carosello (decorativi, a rotazione)
const STORY = ['bg-black text-bd-green', 'bg-bd-green text-black', 'bg-gray-300 text-black', 'bg-black text-white'];
const BOTTLE = [['bg-gray-100', '#7f1d1d'], ['bg-bd-green/30', '#fef3c7'], ['bg-gray-100', '#d9f99d']];
const VISUAL: Record<string, { box: string; deco: string; text: string; stroke: number }> = {
  dark: { box: 'bg-black text-bd-green', deco: 'absolute -right-6 -bottom-6 h-32 w-32 rounded-full bg-bd-green/20', text: 'text-2xl', stroke: 1.8 },
  light: { box: 'bg-gray-100 text-black', deco: '', text: 'text-xl', stroke: 1.6 },
  green: { box: 'bg-bd-green text-black', deco: 'absolute -top-8 -left-8 h-32 w-32 rounded-full bg-white/30', text: 'text-xl', stroke: 1.6 },
};
const lines = (s: string) => s.split('\n').flatMap((l, i) => (i ? ['<br>', l] : [l]));
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO (feed social con post sponsorizzati) -->
  <section class="overflow-hidden pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex items-center gap-2 rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase"><span class="flex items-center gap-1 rounded-full bg-white px-1.5 py-0.5"><Img src={LOGO.meta} alt="" class="h-[14px] w-[14px]" /><Img src={LOGO.facebook} alt="" class="h-[13px] w-[13px]" /><Img src={LOGO.instagram} alt="" class="h-[13px] w-[13px]" /></span>{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-secondary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={g.settings.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>
        <figure class="relative mx-auto w-full max-w-xl" data-feed-demo>
          <div aria-hidden="true" class:list={['absolute top-10 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full opacity-25 blur-3xl', IG]}></div>
          {h.floatFacebook && <span aria-hidden="true" class="float-soft absolute top-16 left-0 z-10 hidden items-center gap-2 rounded-2xl border-2 border-black bg-white px-3 py-2 text-sm font-bold text-black shadow-xl sm:flex"><Img src={LOGO.facebook} alt="" class="h-[22px] w-[22px]" />{h.floatFacebook}</span>}
          {h.floatInstagram && <span aria-hidden="true" class="float-soft float-soft-delay absolute top-40 right-0 z-10 hidden items-center gap-2 rounded-2xl border-2 border-black bg-white px-3 py-2 text-sm font-bold text-black shadow-xl sm:flex"><Img src={LOGO.instagram} alt="" class="h-[22px] w-[22px]" />{h.floatInstagram}</span>}
          {h.floatLead && <span aria-hidden="true" class="float-soft absolute top-[19rem] left-0 z-10 hidden items-center gap-2 rounded-2xl bg-black px-3 py-2 text-xs font-semibold text-white shadow-xl sm:flex"><span class="grid h-6 w-6 place-items-center rounded-full bg-bd-green text-black"><Icon name="check" size={14} stroke={3} /></span>{h.floatLead}</span>}
          <div class="relative mx-auto w-full max-w-[330px] overflow-hidden rounded-[2.4rem] border-[7px] border-black bg-white shadow-2xl">
            <div class="flex items-center justify-between px-4 pt-3 pb-2">
              <span class="flex items-center gap-1.5 text-sm font-bold text-black"><Img src={LOGO.instagram} alt="" class="h-[18px] w-[18px]" />{h.feedHome}</span>
              <span class="flex items-center gap-3 text-black" aria-hidden="true"><Icon name="heart" size={20} /><Img src={LOGO.facebook} alt="" class="h-[18px] w-[18px]" /></span>
            </div>
            <ul class="flex gap-2 overflow-hidden px-3 pb-3" aria-hidden="true">
              <li class="flex w-14 shrink-0 flex-col items-center gap-1"><span class="grid h-12 w-12 place-items-center rounded-full bg-gray-200 p-[2px]"><span class="grid h-full w-full place-items-center rounded-full border-2 border-white bg-gray-100 text-xs font-bold text-black">+</span></span><span class="w-full truncate text-center text-[10px] text-black">{h.storyMine}</span></li>
              {h.stories.map((st, i) => (
                <li class="flex w-14 shrink-0 flex-col items-center gap-1"><span class:list={['grid h-12 w-12 place-items-center rounded-full p-[2px]', IG]}><span class:list={['grid h-full w-full place-items-center rounded-full border-2 border-white text-xs font-bold', STORY[i % 4]]}>{st.charAt(0).toUpperCase()}</span></span><span class="w-full truncate text-center text-[10px] text-black">{st}</span></li>
              ))}
            </ul>
            <div class="border-t border-gray-200" data-feed-slides>
              {h.posts.map((po, i) => {
                const v = VISUAL[po.style] ?? VISUAL.dark;
                return (
                  <div data-feed-slide data-active={i === 0 ? '' : undefined} class="relative overflow-hidden">
                    <article data-feed-post>
                      <header class="flex items-center gap-2.5 px-3 py-2.5">
                        <span class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-full p-[2px]', IG]}><span class="grid h-full w-full place-items-center rounded-full border-2 border-white bg-black text-xs font-bold text-bd-green">{po.letter}</span></span>
                        <span class="min-w-0 flex-1 leading-tight"><span class="block truncate text-sm font-semibold text-black">{po.name}</span><span class="block text-[11px] text-gray-600">{po.place}</span></span>
                        <span class="text-lg leading-none text-black" aria-hidden="true">···</span>
                      </header>
                      {po.kind === 'carousel' ? (
                        <div class="overflow-hidden px-3 pb-3">
                          <ul data-feed-track class="flex gap-2">
                            {po.products.map((pr, k) => (
                              <li class="w-[var(--card)] shrink-0 overflow-hidden rounded-xl border border-gray-200"><span class:list={['grid aspect-square place-items-center', BOTTLE[k % 3][0]]}><svg aria-hidden="true" width="44" height="72" viewBox="0 0 24 40"><path d="M9 2h6v8c3 1.5 4.5 4 4.5 7.5V36a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2V17.5C4.5 14 6 11.5 9 10z" fill={BOTTLE[k % 3][1]} stroke="#000" stroke-width="1.6" stroke-linejoin="round"/><rect x="7" y="20" width="10" height="9" rx="1" fill="#fff" stroke="#000" stroke-width="1.2"/></svg></span><span class="block px-2 py-1.5 text-xs leading-tight"><span class="block font-semibold text-black">{pr.name}</span><span class="font-extrabold text-black">{pr.price}</span></span></li>
                            ))}
                          </ul>
                        </div>
                      ) : (
                        <div class:list={['relative grid aspect-[4/3] place-items-center overflow-hidden', v.box]}>
                          {v.deco && <span class={v.deco}></span>}
                          {po.badge && <span class="absolute top-4 left-4 rounded-full bg-bd-green px-3 py-1 text-xs font-bold">{po.badge}</span>}
                          <span class:list={['text-center', po.style !== 'light' && 'relative']}><span class="mx-auto block w-fit"><Icon name={po.icon as IconName} size={64} stroke={v.stroke} /></span><span class:list={['mt-2 block leading-tight font-extrabold', v.text]}>{lines(po.visual).map((x) => x === '<br>' ? <br /> : x)}</span></span>
                        </div>
                      )}
                      <div class="flex items-center justify-between gap-3 bg-gray-100 px-3 py-2.5">
                        <span class="text-sm font-semibold text-black">{po.barText}</span>
                        <span data-feed-cta class="shrink-0 rounded-lg bg-black px-3 py-1.5 text-xs font-semibold text-white">{po.button}</span>
                      </div>
                      <div class="flex items-center gap-4 px-3 pt-2.5 text-black"><svg aria-hidden="true" data-feed-heart width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.6 12 20l-7.5-7.4A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 7.5 6.5z"/></svg><Icon name="comment" size={22} /><Icon name="send" size={22} /><span class="ml-auto"><Icon name="bookmark" size={22} /></span></div>
                      <p class="px-3 pt-1.5 text-xs font-semibold text-black">{h.likes.split('{n}')[0]}<span data-feed-likes data-base={po.likes ?? 0}>{(po.likes ?? 0) + 1}</span>{h.likes.split('{n}')[1] ?? ''}</p>
                      <p class="px-3 pt-1 pb-3 text-xs text-black"><strong>{po.name}</strong> {po.caption}</p>
                    </article>
                    {po.kind === 'form' && (
                      <div data-feed-form class="absolute inset-x-0 bottom-0 rounded-t-2xl border-t-2 border-black bg-white p-4 shadow-2xl">
                        <p class="text-sm font-bold text-black">{po.formTitle}</p>
                        <p class="mt-2 text-[11px] text-gray-600">{po.f1Label}</p><p class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm text-black">{po.f1Value}</p>
                        <p class="mt-2 text-[11px] text-gray-600">{po.f2Label}</p><p class="rounded-lg border border-gray-300 px-2.5 py-1.5 text-sm text-black">{po.f2Value}</p>
                        <span data-feed-submit class="mt-3 block rounded-lg bg-black py-2 text-center text-sm font-semibold text-white">{po.submit}</span>
                        <span data-feed-sent class="mt-3 items-center justify-center gap-1.5 rounded-lg bg-bd-green py-2 text-sm font-semibold text-black"><Icon name="check" size={16} stroke={3} />{po.sent}</span>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
            <div class="flex items-center justify-around border-t border-gray-200 py-2.5 text-black" aria-hidden="true">
              <Icon name="home" size={22} /><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><Icon name="plus-square" size={22} /><Icon name="reels" size={22} />
              <span class="h-6 w-6 rounded-full bg-black"></span>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2" role="group" aria-label={h.demoLabel}>
            {h.posts.map((po, i) => <button type="button" data-feed-tab aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-gray-200">{po.tab}</button>)}
          </div>
          {h.demoCaption && <figcaption class="mt-3 text-center text-sm text-gray-600">{h.demoCaption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= FACEBOOK E INSTAGRAM, INSIEME -->
  <section class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('platforms')} eyebrow={pl.eyebrow} title={pl.title} text={pl.text} />
      {pl.toolTitle && (
        <div class="mt-8 flex flex-wrap items-center gap-4 rounded-3xl bg-white p-5 md:p-6">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gray-100"><Img src={LOGO.meta} alt="" class="h-[34px] w-[34px]" /></span>
          <p class="min-w-0 flex-1"><strong class="block text-black">{pl.toolTitle}</strong><span class="text-sm">{pl.toolText}</span></p>
          <span class="flex items-center gap-3" aria-hidden="true"><Img src={LOGO.facebook} alt="" class="h-[30px] w-[30px]" /><span class="text-gray-400">+</span><Img src={LOGO.instagram} alt="" class="h-[30px] w-[30px]" /></span>
        </div>
      )}
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-6">
        {pl.items.map((it) => (
          <article class="rounded-3xl bg-white p-6 md:p-10">
            {it.platform === 'instagram'
              ? <span class:list={['grid h-16 w-16 place-items-center rounded-2xl', IG]}><span class="grid h-[3.6rem] w-[3.6rem] place-items-center rounded-[0.9rem] bg-white"><Img src={LOGO.instagram} alt="" class="h-10 w-10" /></span></span>
              : <span class="grid h-16 w-16 place-items-center rounded-2xl bg-gray-100"><Img src={LOGO.facebook} alt="" class="h-10 w-10" /></span>}
            <h3 class="mt-5 text-2xl">{it.title}</h3>
            <p>{it.text}</p>
            {it.chips.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{it.chips.map((c) => <li class="chip">{c}</li>)}</ul>}
          </article>
        ))}
      </div>
      {pl.note && <p class="mt-6 text-xs text-gray-600">{pl.note}</p>}
    </div>
  </section>

  <!-- ================================================= FORMATI -->
  <section id="formati" class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('formats')} eyebrow={fo.eyebrow} title={fo.title} text={fo.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {fo.items.map((it) => (
          <li class:list={['flex flex-col rounded-3xl p-6', it.highlight ? 'bg-black text-white' : 'bg-gray-100']}>
            <h3 class:list={['text-lg', it.highlight && 'text-bd-green']}>{it.title}</h3>
            <p class:list={['text-sm', it.highlight && 'text-gray-300']}>{it.text}</p>
            {it.ideal && <p class:list={['mt-auto pt-4 text-xs font-semibold uppercase', it.highlight ? 'text-gray-400' : 'text-gray-600']}>{it.ideal}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================= CONTATTI, NON LIKE -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class:list={['grid grid-cols-1 items-center gap-10 rounded-3xl p-[3px]', IG]}>
        <div class="grid grid-cols-1 items-center gap-10 rounded-[1.4rem] bg-white p-6 md:p-10 lg:grid-cols-2 lg:gap-16 lg:p-14">
          <SectionHeading n={n('results')} eyebrow={re.eyebrow} title={re.title} text={re.text} class="" />
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-2xl border-2 border-dashed border-gray-300 p-5"><p class="text-xs font-bold text-gray-600 uppercase">{re.noLabel}</p>{re.noItems.map((x, i) => <p class:list={['text-lg font-semibold text-gray-400 line-through decoration-2', i === 0 && 'mt-2']}>{x}</p>)}</div>
            <div class="rounded-2xl bg-black p-5 text-white"><p class="text-xs font-bold text-bd-green uppercase">{re.yesLabel}</p>{re.yesItems.map((x, i) => <p class:list={['text-lg font-semibold', i === 0 && 'mt-2']}>{x}</p>)}</div>
            {re.banner && <p class="col-span-2 rounded-2xl bg-bd-green p-4 text-sm font-semibold text-black">{re.banner}</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <IncludedBox {...p.included} n={n('included')} />
  <MethodSteps {...p.method} n={n('method')} tone="gray" />

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
