---
// SERVIZI › SITI WEB — contenuti in Keystatic → "Siti web" (un gruppo per sezione, SEO in fondo).
// Le sezioni proprie della pagina sono qui sotto; quelle comuni (casi studio, recensioni, offerta, FAQ, blog, contatti)
// sono componenti in src/components/sections/.
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Rich from '../components/ui/Rich.astro';
import Gauge from '../components/ui/Gauge.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CaseStudyCard from '../components/sections/CaseStudyCard.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, entry, pageOffer } from '../lib/content';
import { rich, pad } from '../lib/rich';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';
import { t } from '../i18n/ui';
import type { IconName } from '../lib/icons';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('sitiWeb', lang);
const s = g.settings;
const ui = t(g.lang);
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/siti-web/');

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['types', 'included', 'quality', 'cases', 'steps', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, manifesto: m, types, included: inc, quality: q, cases, steps } = p;
const caseEntries = (await Promise.all(cases.items.filter(Boolean).map(async (slug) => ({ slug: slug!, entry: (await entry('caseStudies', slug, lang))?.entry }))))
  .filter((c) => c.entry);
const offer = await pageOffer(g, p.offer);
const lastInc = inc.items.length - 1;
const lastStep = steps.items.length - 1;
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO -->
  <section class="overflow-hidden pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase">{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-secondary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={s.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>

        <!-- demo animata: un sito che si costruisce in 4 passaggi (main.js → [data-build-demo], stili in global.css → .bd-build) -->
        <figure class="bd-build relative mx-auto w-full max-w-xl pb-10 lg:pb-0" data-build-demo data-step="1">
          <div aria-hidden="true" class="absolute -top-10 -right-16 h-72 w-72 rounded-full bg-bd-green/30"></div>
          <div class="bd-build-stage relative" aria-hidden="true">
            <!-- finestra del browser -->
            <div class="bd-build-window relative overflow-hidden rounded-2xl border-[3px] shadow-2xl mac-window-dark">
              <span class="bd-build-scan"></span>
              <div class="mac-bar-dark"><span class="mac-dots"><i></i><i></i><i></i></span><span class="mac-url bd-build-url"><Icon name="lock" size={12} stroke={2.5} class="bd-build-lock" /><span class="bd-build-domain">{h.demoUrl}</span></span><span class="mac-spacer"></span></div>
              <div class="bd-build-site aspect-[16/11] bg-white p-[4%]">
                <div class="bd-build-nav bd-b flex items-center justify-between rounded-lg px-[3%] py-[2.2%]">
                  <span class="flex items-center gap-2"><span class="bd-build-logo h-3.5 w-3.5 rounded-full"></span><span class="bd-build-brand text-[10px] font-bold">{h.demoBrand}</span></span>
                  <span class="flex items-center gap-2"><i class="bd-line w-6"></i><i class="bd-line w-6"></i><i class="bd-line w-6"></i><span class="bd-build-navcta h-4 w-12 rounded-full"></span></span>
                </div>
                <div class="mt-[3.5%] grid grid-cols-5 gap-[4%]">
                  <div class="bd-build-hero bd-b col-span-3 flex flex-col justify-center rounded-xl p-[6%]">
                    <p class="bd-build-title text-[clamp(14px,2.6vw,22px)] leading-[1.1] font-extrabold text-black">{(h.demoTitle ?? '').split('\n').map((l, i) => <span class="bd-type block" style={`--i:${i}`}>{l}</span>)}</p>
                    <span class="bd-build-txt mt-[6%] block"><i class="bd-line w-full"></i><i class="bd-line mt-1.5 w-4/5"></i></span>
                    <span class="bd-build-cta mt-[7%] inline-flex w-fit rounded-full px-3 py-1 text-[10px] font-bold">{h.demoCta}</span>
                  </div>
                  <div class="bd-build-art bd-b col-span-2 relative overflow-hidden rounded-xl">
                    <span class="bd-build-blob absolute -right-[15%] -bottom-[15%] h-[85%] w-[85%] rounded-full"></span>
                    <span class="bd-build-card absolute top-[14%] left-[12%] h-[38%] w-[55%] rounded-lg"></span>
                  </div>
                </div>
                <div class="mt-[3.5%] grid grid-cols-3 gap-[3%]">
                  {[0, 1, 2].map((i) => <div class="bd-build-box bd-b rounded-lg p-[7%]" style={`--i:${i}`}><span class="bd-build-ico block h-4 w-4 rounded-md"></span><i class="bd-line mt-2 w-4/5"></i><i class="bd-line mt-1 w-3/5"></i></div>)}
                </div>
              </div>
            </div>
            <!-- versione smartphone -->
            <div class="bd-build-phone absolute -bottom-14 -left-3 w-[22%] overflow-hidden rounded-[1.3rem] border-[4px] shadow-2xl sm:-left-8 phone-frame-dark">
              <div class="bg-white p-[9%]">
                <div class="bd-build-nav flex items-center justify-between rounded-md px-[8%] py-[6%]"><span class="bd-build-logo h-2 w-2 rounded-full"></span><i class="bd-line w-4"></i></div>
                <div class="bd-build-hero mt-[10%] rounded-lg p-[10%]"><i class="bd-line bd-dark w-full"></i><i class="bd-line bd-dark mt-1 w-3/4"></i><span class="bd-build-cta mt-[14%] block h-2.5 w-1/2 rounded-full"></span></div>
                <div class="bd-build-art mt-[10%] h-10 relative overflow-hidden rounded-lg"><span class="bd-build-blob absolute -right-3 -bottom-3 h-10 w-10 rounded-full"></span></div>
                <div class="bd-build-box mt-[10%] rounded-md p-[10%]"><i class="bd-line w-full"></i></div>
              </div>
            </div>
            <!-- passaggio 4: punteggi e sito online -->
            <div class="bd-build-scores absolute top-[16%] -right-3 flex gap-1.5 rounded-2xl bg-black p-2.5 shadow-2xl sm:-right-7">
              {[0, 1, 2, 3].map((i) => <span class="relative grid h-9 w-9 place-items-center" style={`--i:${i}`}><svg class="absolute inset-0 -rotate-90" viewBox="0 0 36 36"><circle cx="18" cy="18" r="15" fill="none" stroke-width="3.5" class="stroke-white/15" /><circle class="bd-build-arc" cx="18" cy="18" r="15" fill="none" stroke="#99EA48" stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" /></svg><b class="bd-build-num relative text-[10px] font-extrabold text-white">100</b></span>)}
            </div>
            <span class="bd-build-toast absolute top-[3%] left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-bd-green px-3 py-1.5 text-xs font-bold text-black shadow-xl"><Icon name="check" size={14} stroke={3} />{h.demoToast}</span>
          </div>
          <!-- passaggi -->
          <div class="mt-20 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2" role="group" aria-label={h.demoStepsLabel}>
            {h.demoSteps.slice(0, 4).map((st, i) => <button type="button" data-build-step={i + 1} aria-pressed={i === 0 ? 'true' : 'false'} class="bd-build-pill inline-flex items-center gap-1.5 rounded-full bg-gray-100 py-1.5 pr-3 pl-1.5 text-xs font-semibold text-black transition-colors hover:bg-gray-200 sm:gap-2 sm:py-2 sm:pr-4 sm:pl-2 sm:text-sm"><span class="grid h-5 w-5 place-items-center rounded-full bg-white text-[11px] sm:h-6 sm:w-6 sm:text-xs">{i + 1}</span>{st}</button>)}
          </div>
          {h.demoCaption && <figcaption class="mt-3 text-center text-sm text-gray-600">{h.demoCaption}</figcaption>}
          {h.badgeTitle && (
            <a href={href(h.badgeLink)} class="mx-auto mt-5 flex w-fit items-center gap-2 rounded-2xl bg-black py-2 pr-4 pl-2 text-white shadow-xl sm:absolute sm:-right-6 sm:bottom-[7.5rem] sm:z-10 sm:mt-0">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-bd-green text-black"><Icon name="bolt" size={20} /></span>
              <span class="text-sm leading-tight"><strong class="block">{h.badgeTitle}</strong><span class="text-gray-300">{h.badgeText}</span></span>
            </a>
          )}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= MANIFESTO -->
  <section class="bg-black py-14 md:py-20">
    <div class="container grid grid-cols-1 items-center gap-8 lg:grid-cols-5">
      <p class="text-2xl leading-snug font-bold text-white md:text-4xl lg:col-span-3">{m.line1}<br><span class="text-bd-green">{m.line2}</span></p>
      <p class="text-gray-300 lg:col-span-2" set:html={rich(m.text, { strong: 'text-white' })} />
    </div>
  </section>

  <!-- ================================================= TIPOLOGIE -->
  <section class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('types')} eyebrow={types.eyebrow} title={types.title} text={types.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" data-draw>
        {types.items.map((it, i) => (
          <li class="group flex flex-col rounded-3xl bg-gray-100 p-6 transition-colors duration-300 hover:bg-bd-green" style={`--d:${i * 150}ms`}>
            <span class="draw-badge grid h-16 w-16 place-items-center rounded-2xl bg-black text-bd-green">
              <Icon name={it.icon as IconName} size={32} stroke={1.8} draw />
            </span>
            <h3 class="mt-6">{it.title}</h3>
            <p class="text-sm group-hover:text-black">{it.text}</p>
            {it.audience && <p class="mt-auto pt-4 text-xs font-semibold text-gray-600 uppercase group-hover:text-black">{it.audience}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================= COSA È INCLUSO -->
  <section id="incluso" class="bg-gray-100 py-16 md:py-24">
    <div class="container grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-2">
        <div class="lg:sticky lg:top-28">
          <SectionHeading n={n('included')} eyebrow={inc.eyebrow} title={inc.title} text={inc.text} class="" />
          <Img src={inc.image} alt={inc.imageAlt} class="float-soft mx-auto mt-8 w-full max-w-md" />
          {inc.ctaLabel && <a href={href(inc.ctaLink)} class="btn-secondary mt-8">{inc.ctaLabel}</a>}
        </div>
      </div>
      <ol class="space-y-3 lg:col-span-3">
        {inc.items.map((it, i) => {
          const dark = i === lastInc && lastInc > 0;
          return (
            <li class:list={['flex gap-5 rounded-3xl p-6', dark ? 'bg-black text-white' : 'bg-white']}>
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bd-green text-sm font-bold text-black">{pad(i + 1)}</span>
              <div>
                <h3 class:list={['mb-1 text-lg', dark && 'text-bd-green']}>{it.title}</h3>
                <p class:list={['text-sm', dark && 'text-gray-300']}>{it.text}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================================================= QUALITÀ VERIFICABILE -->
  <section id="qualita" class="py-16 md:py-24">
    <div class="container">
      <div class="grid grid-cols-1 items-center gap-10 rounded-3xl bg-black p-6 text-white md:p-10 lg:grid-cols-2 lg:gap-16 lg:p-14">
        <SectionHeading n={n('quality')} eyebrow={q.eyebrow} title={q.title} text={q.text} dark class="">
          {q.linkLabel && (
            <a href={href(q.linkLink)} {...(q.linkNewTab ? { target: '_blank', rel: 'noopener' } : {})} class="mt-6 inline-block font-medium text-bd-green underline underline-offset-4 hover:no-underline">{q.linkLabel}{q.linkNewTab && <span class="sr-only">{ui.newTab}</span>}</a>
          )}
        </SectionHeading>
        <div>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4" aria-label={q.scoresLabel || s.a11y.scores} data-gauge-group>
            {q.scores.map((sc) => (
              <li class="rounded-2xl bg-white/10 p-4 text-center"><Gauge value={sc.value ?? 100} dark class="mx-auto h-16 w-16" /><span class="mt-2 block text-xs text-gray-300">{sc.label}</span></li>
            ))}
          </ul>
          {q.checks.length > 0 && (
            <ul class="mt-6 grid grid-cols-1 gap-3 text-sm text-gray-200 sm:grid-cols-2">
              {q.checks.map((c) => <li class="flex gap-2"><Icon name="check" size={18} stroke={3} class="mt-0.5 shrink-0 text-bd-green" />{c}</li>)}
            </ul>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================= CASI STUDIO -->
  {caseEntries.length > 0 && (
    <section id="casi-studio" class="pb-16 md:pb-24">
      <div class="container">
        <SectionHeading n={n('cases')} eyebrow={cases.eyebrow} title={cases.title} text={cases.text} />
        {caseEntries.map((c, i) => <CaseStudyCard g={g} slug={c.slug} title={c.entry!.title} card={c.entry!.card} class={i === 0 ? 'mt-10' : 'mt-6'} />)}
      </div>
    </section>
  )}

  <!-- ================================================= COME FUNZIONA -->
  <section id="come-funziona" class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('steps')} eyebrow={steps.eyebrow} title={steps.title} text={steps.text} />
      <ol class="relative mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 lg:grid-cols-6 lg:gap-4 lg:before:absolute lg:before:top-7 lg:before:right-[calc((100%_-_5rem)/6_-_1.75rem)] lg:before:left-7 lg:before:border-t-2 lg:before:border-dashed lg:before:border-black/30 lg:before:content-['']">
        {steps.items.map((st, i) => {
          const green = i === 0 || i === lastStep;
          return (
            <li class="relative">
              <span class:list={['grid h-14 w-14 place-items-center rounded-full text-lg font-bold ring-8 ring-gray-100', green ? 'bg-bd-green text-black' : 'bg-black text-bd-green']}>{i + 1}</span>
              <h3 class="mt-4 text-lg">{st.title}</h3>
              <p class="text-sm">{st.text}</p>
            </li>
          );
        })}
      </ol>
      {steps.boxTitle && (
        <div class="mt-12 flex flex-col items-start gap-4 rounded-3xl bg-white p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
          <div>
            <p class="text-lg font-semibold text-black">{steps.boxTitle}</p>
            {steps.boxText && <p class="text-sm">{steps.boxText}</p>}
          </div>
          {steps.boxCtaLabel && <a href={href(steps.boxCtaLink)} class="btn-secondary shrink-0">{steps.boxCtaLabel} <Icon name="arrow" size={20} /></a>}
        </div>
      )}
    </div>
  </section>

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
