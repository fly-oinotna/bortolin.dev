---
// SERVIZI › AI ADS — contenuti in Keystatic → "AI Ads" (un gruppo per sezione, SEO in fondo).
// Sezioni proprie della pagina qui sotto; quelle comuni (cosa è incluso, recensioni, offerta, FAQ, blog, contatti)
// da src/components/sections/. La chat dell'hero è animata da main.js ([data-chat-demo]).
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import IncludedBox from '../components/sections/IncludedBox.astro';
import Reviews from '../components/sections/Reviews.astro';
import OfferBand from '../components/sections/OfferBand.astro';
import Faq from '../components/sections/Faq.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, pageOffer } from '../lib/content';
import { href } from '../lib/links';
import { serviceTrail } from '../lib/pages';
import { faqSchema } from '../lib/schema';

interface Props { lang?: string }
const { lang = 'it' } = Astro.props;
const g = await readGlobals(lang);
const p = await read('aiAds', lang);
const trail = serviceTrail(g, p.hero.breadcrumb || p.hero.title, '/servizi/ai-ads/');
const offer = await pageOffer(g, p.offer);

// numeri delle etichette (01, 02…) in ordine di pagina: spostando una sezione, aggiornare anche qui
const ORDER = ['why', 'where', 'compare', 'included', 'method', 'reviews', 'faq'];
const n = (key: string) => ORDER.indexOf(key) + 1;

const { hero: h, why, where: wh, compare: cp, method: me } = p;
const lastWhy = why.items.length - 1;
const lastMe = me.items.length - 1;
// illustrazioni dei prodotti negli annunci (decorative, a rotazione)
const PRODUCT = [
  '<path d="M5 10h14l-1.5 9a2 2 0 0 1-2 1.7h-7a2 2 0 0 1-2-1.7z" fill="#99EA48" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 10l4-6 4 6" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 14v3M12 14v3M15 14v3" stroke="#000" stroke-width="1.6" stroke-linecap="round"/>',
  '<path d="M3 17 18 7l3 3v7z" fill="#fde68a" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 17h18" stroke="#000" stroke-width="1.6"/><circle cx="14" cy="13.5" r="1.3" fill="#000"/><circle cx="18" cy="14.5" r="1" fill="#000"/>',
  '<path d="M10 3h4v4.5c2 1 3 2.7 3 5V20a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 20v-7.5c0-2.3 1-4 3-5z" fill="#7f1d1d" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/><rect x="8.5" y="13" width="7" height="5" rx="1" fill="#fff" stroke="#000" stroke-width="1.2"/>',
];
const dots = '<span class="h-2 w-2 rounded-full bg-black"></span>'.repeat(3);
---
<Base g={g} seo={p.seo} breadcrumb={trail} schema={{ service: { name: trail[trail.length - 1].name }, faq: faqSchema(p.faq.items) }}>

  <!-- ================================================= HERO (chat AI con annuncio sponsorizzato) -->
  <section class="overflow-hidden bg-gray-100 pt-8 pb-20 md:pt-12 md:pb-28">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <span class="mb-5 inline-flex items-center gap-1.5 rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green uppercase"><Icon name="sparkles-fill" size={14} />{h.eyebrow}</span>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{h.title}</h1>
          <div class="my-6"><Rich value={h.text} class="text-lg" /></div>
          <div class="flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-secondary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {h.linkLabel && <a href={href(h.linkLink)} class="font-medium text-black underline underline-offset-4 hover:no-underline">{h.linkLabel}</a>}
          </div>
          {h.highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label={g.settings.a11y.highlights}>
              {h.highlights.map((c) => <li class="chip"><Icon name="check" size={16} stroke={3} />{c}</li>)}
            </ul>
          )}
        </div>
        <figure class="relative mx-auto w-full max-w-xl" data-chat-demo>
          <div aria-hidden="true" class="absolute -top-12 -right-12 h-64 w-64 rounded-full bg-bd-green/40"></div>
          <div class="relative overflow-hidden rounded-3xl border-[3px] border-black bg-white shadow-2xl">
            <div class="flex items-center justify-between bg-black px-5 py-3 text-sm text-white">
              <span class="flex items-center gap-2 font-semibold"><span class="text-bd-green"><Icon name="sparkles-fill" size={16} /></span>{h.chatTitle}</span>
              <span class="flex gap-1.5" aria-hidden="true"><span class="h-2.5 w-2.5 rounded-full bg-white/30"></span><span class="h-2.5 w-2.5 rounded-full bg-white/30"></span><span class="h-2.5 w-2.5 rounded-full bg-bd-green"></span></span>
            </div>
            <div class="p-5 md:p-6" data-chat-slides>
              {h.examples.map((ex, i) => (
                <div data-chat-slide data-active={i === 0 ? '' : undefined} data-prompt={ex.question}>
                  <div class="flex justify-end"><p class="max-w-[85%] rounded-2xl rounded-br-md bg-black px-4 py-2.5 text-sm text-white" data-chat-question>{ex.question}</p></div>
                  <div class="mt-4 flex gap-3">
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-bd-green text-black"><Icon name="sparkles-fill" size={16} /></span>
                    <div class="min-w-0 flex-1">
                      <p data-chat-thinking hidden class="flex gap-1 pt-2.5" aria-hidden="true" set:html={dots} />
                      <p class="text-sm leading-relaxed text-black" data-chat-answer>{ex.answer}</p>
                      <div data-chat-ad class="mt-4 rounded-2xl border-2 border-black bg-bd-green/30 p-4">
                        <div class="flex items-center justify-between gap-2">
                          <span class="flex items-center gap-2"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-black text-xs font-bold text-bd-green">{ex.letter}</span><span class="leading-tight"><span class="block text-sm font-semibold text-black">{ex.name}</span><span class="block text-xs text-gray-600">{ex.place}</span></span></span>
                          <span class="rounded-full bg-white px-2 py-0.5 text-[11px] font-bold text-black">{h.adLabel}</span>
                        </div>
                        {ex.products.length > 0 ? (
                          <ul class="mt-3 grid grid-cols-3 gap-2">
                            {ex.products.map((pr, k) => (
                              <li class="rounded-xl bg-white p-2"><span class="grid aspect-[4/3] place-items-center rounded-lg bg-gray-100"><svg aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" set:html={PRODUCT[k % 3]} /></span><span class="mt-1.5 block text-[11px] leading-tight font-semibold text-black">{pr.name}</span><span class="block text-sm font-extrabold text-black">{pr.price}</span></li>
                            ))}
                          </ul>
                        ) : (
                          <>
                            <p class="mt-3 font-semibold leading-snug text-black">{ex.title}</p>
                            <p class="mt-1 text-sm text-gray-700">{ex.text}</p>
                            {ex.button && <span class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-black px-3.5 py-1.5 text-xs font-semibold text-white">{ex.button}<Icon name="arrow" size={14} stroke={2.5} /></span>}
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="flex items-center gap-3 border-t border-gray-200 px-5 py-3.5">
              <span class="min-h-[1.25rem] flex-1 truncate text-sm text-gray-600" data-chat-input>{h.chatPlaceholder}</span>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-black text-bd-green" aria-hidden="true"><Icon name="arrow-up" size={16} stroke={2.5} /></span>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2" role="group" aria-label={h.demoLabel}>
            {h.examples.map((ex, i) => <button type="button" data-chat-tab aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-gray-200">{ex.tab}</button>)}
          </div>
          {h.demoCaption && <figcaption class="mt-3 text-center text-sm text-gray-600">{h.demoCaption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= PERCHÉ ORA -->
  <section class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('why')} eyebrow={why.eyebrow} title={why.title} text={why.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-6">
        {why.items.map((it, i) => {
          const dark = i === lastWhy && lastWhy > 0;
          return (
            <li class:list={['rounded-3xl p-6 md:p-8', dark ? 'bg-black text-white' : 'bg-white']}>
              <p class:list={['text-4xl font-extrabold', dark ? 'text-bd-green' : 'text-black']}>{it.value}</p>
              <h3 class:list={['mt-4', dark && 'text-white']}>{it.title}</h3>
              <p class:list={['text-sm', dark && 'text-gray-300']}>{it.text}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ================================================= DOVE COMPAIONO -->
  <section id="dove" class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('where')} eyebrow={wh.eyebrow} title={wh.title} text={wh.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3 lg:gap-6">
        {wh.items.map((it) => (
          <li class:list={['flex flex-col rounded-3xl p-6 md:p-8', it.highlight ? 'bg-bd-green' : 'bg-gray-100']}>
            <h3 class="mb-1 text-2xl">{it.title}</h3>
            <p class:list={['text-sm font-semibold', it.highlight ? 'text-black' : 'text-gray-600']}>{it.subtitle}</p>
            <p class:list={['mt-4 text-sm', it.highlight && 'text-black']}>{it.text}</p>
          </li>
        ))}
      </ul>
      {wh.note && <p class="mt-6 text-xs text-gray-600">{wh.note}</p>}
    </div>
  </section>

  <!-- ================================================= DIFFERENZE CON GOOGLE ADS -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class="rounded-3xl bg-gray-100 p-6 md:p-10 lg:p-14">
        <SectionHeading n={n('compare')} eyebrow={cp.eyebrow} title={cp.title} text={cp.text} />
        <div class="mt-8 overflow-hidden rounded-2xl bg-white">
          <div class="grid grid-cols-2 bg-black text-sm font-semibold text-white sm:grid-cols-3">
            <span class="hidden p-4 sm:block"></span><span class="p-4">{cp.colA}</span><span class="p-4 text-bd-green">{cp.colB}</span>
          </div>
          {cp.rows.map((r) => (
            <div class="grid grid-cols-2 border-t border-gray-200 text-sm sm:grid-cols-3">
              <span class="col-span-2 bg-gray-50 px-4 py-2.5 font-semibold text-black sm:col-span-1 sm:bg-transparent sm:p-4">{r.label}</span><span class="p-4">{r.a}</span><span class="bg-bd-green/15 p-4 text-black">{r.b}</span>
            </div>
          ))}
        </div>
        <Rich value={cp.note} class="mt-6 text-sm" />
      </div>
    </div>
  </section>

  <IncludedBox {...p.included} n={n('included')} />

  <!-- ================================================= IL METODO -->
  <section class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={n('method')} eyebrow={me.eyebrow} title={me.title} text={me.text} />
      <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {me.items.map((st, i) => {
          const dark = i === lastMe && lastMe > 0;
          return (
            <li class:list={['rounded-3xl p-6', dark ? 'bg-black text-white' : 'bg-white']}>
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-bd-green text-lg font-extrabold text-black" aria-hidden="true">{i + 1}</span>
              <h3 class:list={['mt-4 text-lg', dark && 'text-white']}>{st.title}</h3>
              <p class:list={['text-sm', dark && 'text-gray-300']}>{st.text}</p>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ================================================= SEZIONI COMUNI -->
  <Reviews g={g} n={n('reviews')} />
  <OfferBand g={g} offer={offer} class="container" />
  <Faq {...p.faq} n={n('faq')} class={offer ? 'py-16 md:py-24' : 'pb-16 md:pb-24'} />
  {p.blog.enabled && <BlogTeaser categories={p.blog.categories} title={p.blog.title} text={p.blog.text} buttonLabel={p.blog.buttonLabel} />}
  <Contact g={g} page={p.contact} />
</Base>
