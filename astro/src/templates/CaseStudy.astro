---
// TEMPLATE CASO STUDIO (pagina singola) — collection Keystatic "Casi studio": un gruppo per sezione, SEO in fondo.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Rich from '../components/ui/Rich.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reviews from '../components/sections/Reviews.astro';
import Contact from '../components/sections/Contact.astro';
import { read, readGlobals, entry } from '../lib/content';
import { caseUrl } from '../lib/pages';
import { href } from '../lib/links';
import { t } from '../i18n/ui';
import type { IconName } from '../lib/icons';

interface Props { lang?: string; /** slug della versione italiana */ slug: string }
const { lang = 'it', slug } = Astro.props;
const g = await readGlobals(lang);
const e = (await entry('caseStudies', slug, lang))!.entry;
const archive = await read('casiStudio', lang);
const ui = t(g.lang);
const s = g.settings.caseStudies;
const trail = [{ name: archive.hero.breadcrumb || ui.caseStudy, url: g.url('/casi-studio/') }, { name: e.title, url: g.url(caseUrl(slug)) }];
const { card: c, hero: h, client: cl, solution: so, showcase: sh, results: rs, cta } = e;
/** risultato ancora da compilare ("—") */
// altri casi studio: nell'ordine dell'archivio, senza quello corrente
const others = (await Promise.all(archive.list.items.filter((x) => x && x !== slug).map(async (o) => ({ slug: o!, e: (await entry('caseStudies', o, lang))?.entry })))).filter((x) => x.e);
// immagine del progetto per i dati strutturati (jpg ottimizzato, come l'immagine social)
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{webp,png,jpg,jpeg}', { eager: true });
const projectImage = c.desktopImage && shots[c.desktopImage] ? (await getImage({ src: shots[c.desktopImage].default, width: 1200, format: 'jpg' })).src : undefined;
const empty = (v?: string | null) => !v || v.trim() === '—' || v.trim() === '-';
---
<Base g={g} seo={e.seo} breadcrumb={trail} schema={{ project: { name: e.title, url: c.siteUrl, image: projectImage, about: h.intro } }}>

  <!-- ================================================= HERO -->
  <section class="overflow-hidden bg-gray-100 pt-8 pb-16 md:pt-12 md:pb-24">
    <div class="container">
      <Breadcrumb items={trail} />
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          {h.eyebrow && <p class="mb-4 text-sm font-bold text-gray-600 uppercase">{h.eyebrow}</p>}
          <h1 class="text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">{e.title}</h1>
          <p class="my-6 text-lg">{h.intro}</p>
          {h.tags.length > 0 && <ul class="flex flex-wrap gap-2" aria-label={g.settings.a11y.projectTags}>{h.tags.map((tg) => <li class="rounded-full bg-black px-3 py-1 text-xs font-bold text-bd-green">{tg}</li>)}</ul>}
          <div class="mt-8 flex flex-wrap items-center gap-4">
            {h.ctaLabel && <a href={href(h.ctaLink)} class="btn-primary">{h.ctaLabel} <Icon name="arrow" size={20} /></a>}
            {c.siteUrl && <a href={c.siteUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-black underline underline-offset-4 hover:no-underline">{s.visitLabel} <Icon name="external" size={18} /><span class="sr-only">{ui.newTab}</span></a>}
          </div>
        </div>
        <div class="relative pb-8 pl-6 sm:pl-10">
          <figure class="overflow-hidden rounded-2xl border-[3px] shadow-2xl mac-window-dark">
            <div class="mac-bar-dark"><span class="mac-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="mac-url">{c.domain}</span><span class="mac-spacer" aria-hidden="true"></span></div>
            <Img src={c.desktopImage} alt={c.desktopAlt} widths={[720, 1200]} sizes="(min-width: 1024px) 600px, 90vw" loading="eager" fetchpriority="high" class="block aspect-[16/10] w-full object-cover object-top" />
          </figure>
          {c.mobileImage && (
            <figure class="absolute bottom-0 left-0 w-[27%] overflow-hidden rounded-[1.4rem] border-[4px] shadow-xl phone-frame-dark">
              <span class="phone-bar rounded-t-[1rem]" aria-hidden="true"><span>{c.domain}</span></span>
              <Img src={c.mobileImage} alt={c.mobileAlt} widths={[220, 440]} sizes="(min-width: 1024px) 160px, 24vw" class="block aspect-[9/19.5] w-full rounded-b-[1rem] object-cover object-top" />
            </figure>
          )}
        </div>
      </div>
      {h.details.length > 0 && (
        <dl class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5">
          {h.details.map((d) => <div class="rounded-2xl bg-white p-4"><dt class="text-xs font-bold text-gray-600 uppercase">{d.label}</dt><dd class="mt-1 font-semibold text-black">{d.value}</dd></div>)}
        </dl>
      )}
    </div>
  </section>

  <!-- ================================================= IL CLIENTE E LA SFIDA -->
  <section class="py-16 md:py-24">
    <div class="container grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHeading n={1} eyebrow={cl.eyebrow} title={cl.title} text={cl.text} class="" />
      <div class="rounded-3xl bg-black p-6 text-white md:p-10">
        <p class="text-sm font-bold text-bd-green uppercase">{cl.challengeLabel}</p>
        <p class="mt-3 text-lg text-white">{cl.challengeText}</p>
        <ul class="mt-6 space-y-3 text-gray-200">{cl.challengePoints.map((pt) => <li class="flex gap-3"><Icon name="check" size={18} stroke={3} class="mt-0.5 shrink-0 text-bd-green" /><span>{pt}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ================================================= LA SOLUZIONE -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <SectionHeading n={2} eyebrow={so.eyebrow} title={so.title} text={so.text} />
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {so.items.map((it) => (
          <li class="rounded-3xl bg-gray-100 p-6 md:p-8">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-black text-bd-green"><Icon name={it.icon as IconName} size={26} /></span>
            <h3 class="mt-5">{it.title}</h3>
            <p class="text-sm">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================= IL SITO IN DETTAGLIO -->
  <section class="bg-gray-100 py-16 md:py-24">
    <div class="container">
      <SectionHeading n={3} eyebrow={sh.eyebrow} title={sh.title}>
        <Rich value={sh.text} class="hidden md:block" />
      </SectionHeading>
      <div class="mt-10 grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
        <figure class="overflow-hidden rounded-2xl border-[3px] shadow-2xl lg:col-span-2 mac-window-dark">
          <div class="mac-bar-dark"><span class="mac-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="mac-url">{c.domain}</span><span class="mac-spacer" aria-hidden="true"></span></div>
          <div class="shot-scroll" tabindex="0" aria-label={sh.scrollLabel}><Img src={c.longImage} alt={c.longAlt} widths={[480, 720]} sizes="(min-width: 1024px) 720px, 90vw" class="block w-full" /></div>
        </figure>
        <figure class="mx-auto w-full max-w-[16rem] overflow-hidden rounded-[2rem] border-[6px] shadow-2xl phone-frame-dark">
          <span class="phone-bar rounded-t-[1.5rem]" aria-hidden="true"><span>{c.domain}</span></span>
          <Img src={c.mobileImage} alt={c.mobileAlt} widths={[440]} sizes="256px" class="block w-full rounded-b-[1.5rem]" />
          {sh.mobileCaption && <figcaption class="sr-only">{sh.mobileCaption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ================================================= PRIMA E DOPO -->
  <section class="py-16 md:py-24">
    <div class="container">
      <SectionHeading n={4} eyebrow={rs.eyebrow} title={rs.title} />
      <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
        <div class="rounded-3xl border-2 border-dashed border-gray-300 p-6 md:p-8">
          <p class="text-sm font-bold text-gray-600 uppercase">{rs.beforeLabel}</p>
          <ul class="mt-4 space-y-3 text-gray-600">{rs.before.map((x) => <li>— {x}</li>)}</ul>
        </div>
        <div class="rounded-3xl bg-bd-green p-6 text-black md:p-8">
          <p class="text-sm font-bold uppercase">{rs.afterLabel}</p>
          <ul class="mt-4 space-y-3">{rs.after.map((x) => <li class="flex gap-3"><Icon name="check" size={18} stroke={3} class="mt-0.5 shrink-0" /><span>{x}</span></li>)}</ul>
        </div>
      </div>
      {rs.kpis.length > 0 && (
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {rs.kpis.map((k) => empty(k.value)
            ? <div class="rounded-2xl border-2 border-dashed border-gray-300 bg-white p-5"><p class="text-xs font-bold text-gray-600 uppercase">{k.label}</p><p class="mt-2 text-2xl font-extrabold text-gray-400">—</p><p class="text-sm text-gray-600">{k.note}</p></div>
            : <div class="rounded-2xl bg-gray-100 p-5"><p class="text-xs font-bold text-gray-600 uppercase">{k.label}</p><p class="mt-2 text-2xl font-extrabold text-black">{k.value}</p><p class="text-sm">{k.note}</p></div>)}
        </div>
      )}
    </div>
  </section>

  <!-- ================================================= INVITO FINALE -->
  <section class="pb-16 md:pb-24">
    <div class="container">
      <div class="flex flex-col items-start gap-6 rounded-3xl bg-black p-6 text-white md:p-10 lg:flex-row lg:items-center lg:justify-between lg:p-14">
        <div class="max-w-2xl">
          <h2 class="text-white">{cta.title}</h2>
          {cta.text && <p class="text-gray-300">{cta.text}</p>}
        </div>
        {cta.ctaLabel && <a href={href(cta.ctaLink)} class="btn-primary shrink-0">{cta.ctaLabel} <Icon name="arrow" size={20} /></a>}
      </div>
    </div>
  </section>

  <Reviews g={g} n={5} class="pb-16 md:pb-24" />

  <!-- ================================================= ALTRI CASI STUDIO -->
  {others.length > 0 && (
    <section class="pb-16 md:pb-24">
      <div class="container">
        <h2>{archive.related.title}</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-6">
          {others.map(({ slug: os, e: oe }) => (
            <a href={g.url(caseUrl(os))} class:list={['group grid grid-cols-1 items-center gap-6 rounded-3xl bg-gray-100 p-6 transition-colors hover:bg-bd-green sm:grid-cols-2 md:p-8', others.length === 1 && 'md:col-span-2']}>
              <Img src={oe!.card.desktopImage} alt="" widths={[720]} sizes="(min-width: 768px) 560px, 90vw" class="aspect-[16/10] w-full rounded-2xl border-2 border-black object-cover object-top" />
              <span><span class="text-sm font-bold text-gray-600 uppercase group-hover:text-black">{oe!.hero.eyebrow}</span><span class="mt-1 block text-2xl font-bold text-black">{oe!.title}</span><span class="mt-2 block">{oe!.hero.intro}</span><span class="mt-4 inline-flex items-center gap-1 font-semibold text-black">{s.readLabel} <Icon name="arrow" size={20} /></span></span>
            </a>
          ))}
        </div>
        {archive.related.allLabel && <p class="mt-6"><a href={g.url('/casi-studio/')} class="font-semibold text-black underline underline-offset-4 hover:no-underline">{archive.related.allLabel}</a></p>}
      </div>
    </section>
  )}
  <Contact g={g} page={e.contact} />
</Base>
