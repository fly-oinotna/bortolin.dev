---
// /admin/login — accesso al pannello: clienti con email e password, admin con GitHub. Mai su Google.
import { ADMIN_THEME } from './theme';
import { whoIs } from './auth';
export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');
// già collegato (cliente, oppure admin online): al pannello. In sviluppo tutti sono admin: la pagina resta visibile per le prove
const who = await whoIs(Astro.request);
if (who && (who.role === 'cliente' || !import.meta.env.DEV) && !Astro.url.searchParams.has('esci')) return Astro.redirect('/admin');
const githubLogin = import.meta.env.DEV ? '/admin' : '/api/keystatic/github/login';
const t = ADMIN_THEME;
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Accedi · bortolin.dev</title>
    <link rel="icon" href="/favicon.ico" />
    <style define:vars={{ accent: t.accent, on: t.onAccent }}>
      :root { color-scheme: light dark; --bg: #f6f6f6; --card: #fff; --text: #111; --muted: #666; --line: #ddd; }
      @media (prefers-color-scheme: dark) { :root { --bg: #161616; --card: #222; --text: #eee; --muted: #9a9a9a; --line: #3a3a3a; } }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
      main { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 32px 28px; }
      h1 { margin: 0 0 4px; font-size: 22px; }
      p.sub { margin: 0 0 24px; color: var(--muted); font-size: 14px; }
      label { display: block; font-size: 13px; font-weight: 600; margin: 14px 0 6px; }
      input { width: 100%; padding: 11px 12px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: inherit; font: inherit; }
      input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button.primary { width: 100%; margin-top: 20px; padding: 12px; border: 0; border-radius: 999px; background: var(--accent); color: var(--on); font: 700 15px system-ui, sans-serif; cursor: pointer; }
      button[disabled] { opacity: .6; cursor: progress; }
      .err { min-height: 20px; margin: 12px 0 0; color: #e5484d; font-size: 13px; }
      .sep { display: flex; align-items: center; gap: 12px; margin: 24px 0 16px; color: var(--muted); font-size: 12px; }
      .sep::before, .sep::after { content: ""; flex: 1; height: 1px; background: var(--line); }
      a.gh { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 11px; border-radius: 999px; border: 1px solid var(--line); color: inherit; text-decoration: none; font-weight: 600; font-size: 14px; }
      a.gh:hover { border-color: var(--accent); }
    </style>
  </head>
  <body>
    <main>
      <h1 data-t="title">Accedi al pannello</h1>
      <p class="sub">bortolin.dev</p>
      <form id="f">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required />
        <label for="pw">Password</label>
        <input id="pw" name="password" type="password" autocomplete="current-password" required />
        <button class="primary" type="submit" data-t="login">Accedi</button>
        <p class="err" role="alert" id="err"></p>
      </form>
      <div class="sep" data-t="admins">Amministratori</div>
      <a class="gh" href={githubLogin}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg><span data-t="github">Accedi con GitHub</span></a>
    </main>
    <script>
      // lingua del browser (prima dell'accesso non si sa ancora quella del cliente)
      const L: Record<string, Record<string, string>> = {
        en: { title: 'Sign in to the panel', login: 'Sign in', admins: 'Administrators', github: 'Sign in with GitHub', bad: 'Incorrect email or password.', many: 'Too many attempts: try again in a few minutes.', fail: 'Sign-in failed' },
        es: { title: 'Accede al panel', login: 'Acceder', admins: 'Administradores', github: 'Acceder con GitHub', bad: 'Email o contraseña incorrectos.', many: 'Demasiados intentos: vuelve a intentarlo en unos minutos.', fail: 'No se ha podido acceder' },
        de: { title: 'Im Panel anmelden', login: 'Anmelden', admins: 'Administratoren', github: 'Mit GitHub anmelden', bad: 'E-Mail oder Passwort falsch.', many: 'Zu viele Versuche: Bitte in ein paar Minuten erneut versuchen.', fail: 'Anmeldung fehlgeschlagen' },
      };
      const dict = L[navigator.language.slice(0, 2)];
      if (dict) {
        document.documentElement.lang = navigator.language.slice(0, 2);
        document.querySelectorAll<HTMLElement>('[data-t]').forEach((el) => { const v = dict[el.dataset.t!]; if (v) el.textContent = v; });
        document.title = `${dict.title} · ${location.host}`;
      }
      const msgOf = (status: number, fallback: string) => (dict ? (status === 401 ? dict.bad : status === 429 ? dict.many : dict.fail) : fallback);
      const f = document.getElementById('f') as HTMLFormElement;
      const err = document.getElementById('err')!;
      // ?esci: si esce dalla sessione cliente
      if (new URLSearchParams(location.search).has('esci')) fetch('/api/auth', { method: 'DELETE' }).then(() => history.replaceState(null, '', '/admin/login'));
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = f.querySelector('button')!;
        btn.disabled = true; err.textContent = '';
        try {
          const r = await fetch('/api/auth', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: (f.email as any).value, password: (f.password as any).value }) });
          const out = await r.json();
          if (!r.ok) throw new Error(msgOf(r.status, out.error || 'Accesso non riuscito'));
          location.href = '/admin';
        } catch (x) { err.textContent = (x as Error).message; btn.disabled = false; }
      });
    </script>
  </body>
</html>
