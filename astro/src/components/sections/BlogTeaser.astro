---
// "DAL BLOG": gli ultimi articoli di una o più categorie (Keystatic → Post), sotto le FAQ delle pagine servizio.
// Senza categorie (es. pagina 404): gli ultimi articoli di tutto il blog.
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import Rich from '../ui/Rich.astro';
import { entries } from '../../lib/content';
import { localize } from '../../lib/i18n';
import { t } from '../../i18n/ui';
import { postUrl } from '../../lib/pages';
import { categoryLabel, readingTime } from '../../lib/blog';
import type { RichValue } from '../../lib/rich';

interface Props { categories: readonly string[]; title: string; text?: RichValue; buttonLabel: string; buttonHref?: string; eyebrow?: string; count?: number; class?: string }
const { categories, title, text, buttonLabel, buttonHref, eyebrow, count = 2, class: cls = 'pb-16 md:pb-24' } = Astro.props;

const lang = Astro.currentLocale ?? 'it';
const all = (await entries('posts', lang)).sort((a, b) => String(b.entry.content.date).localeCompare(String(a.entry.content.date)));
const posts = (categories.length ? categories.flatMap((c) => all.filter((p) => p.entry.content.category === c)) : all).slice(0, count);
const link = buttonHref ?? localize(categories.length === 1 ? `/blog/?categoria=${categories[0]}` : '/blog/', lang);
const fmt = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
---
{posts.length > 0 && (
  <section class={cls} aria-labelledby="blog-servizio-titolo">
    <div class="container">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <p class="eyebrow"><span><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/></svg></span><span>{eyebrow || t(lang).fromBlog}</span></p>
          <h2 id="blog-servizio-titolo">{title}</h2>
          <Rich value={text} />
        </div>
        <a href={link} class="btn-empty-primary shrink-0">{buttonLabel} <Icon name="arrow" size={20} /></a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {posts.map((p) => (
          <article class="group relative grid grid-cols-1 overflow-hidden rounded-3xl bg-gray-100 sm:grid-cols-5">
            <div class="relative aspect-[16/10] overflow-hidden sm:col-span-2 sm:aspect-auto">
              <Img src={p.entry.content.image} alt="" widths={[480, 640]} sizes="(min-width: 640px) 260px, 100vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="flex flex-col p-6 sm:col-span-3">
              <span class="w-fit rounded-full bg-white px-3 py-1 text-xs font-bold text-black">{categoryLabel(p.entry.content.category, lang)}</span>
              <h3 class="mt-3 text-lg leading-snug"><a href={localize(postUrl(p.itSlug), lang)} class="after:absolute after:inset-0 group-hover:underline">{p.entry.title}</a></h3>
              <p class="text-sm">{p.entry.content.excerpt}</p>
              <p class="mt-auto flex items-center justify-between gap-3 pt-4 text-xs text-gray-600">
                <span class="flex items-center gap-3"><time datetime={p.entry.content.date}>{fmt.format(new Date(`${p.entry.content.date}T12:00:00`))}</time><span class="flex items-center gap-1"><Icon name="clock" size={14} stroke={2.2} />{readingTime(p.entry.content)} min</span></span>
                <span class="grid h-9 w-9 place-items-center rounded-full bg-black text-bd-green transition-transform group-hover:translate-x-1"><Icon name="arrow" size={20} /></span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
