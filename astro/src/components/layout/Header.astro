---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import MegaMenu from './MegaMenu.astro';
import type { Globals } from '../../lib/content';
import { href } from '../../lib/links';
interface Props { g: Globals }
const { g } = Astro.props;
const { navigation: nav, settings: s } = g;
const cta = { label: s.general.headerCtaLabel, href: href(s.general.headerCtaLink) };
---
<header class="sticky top-0 z-40 border-b border-gray-100 bg-white/95 backdrop-blur">
  <div class="container flex h-20 items-center justify-between">
    <Logo label={s.a11y.home} />

    <nav aria-label={s.a11y.mainNav} class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-1">
        <li class="group flex h-full items-center" data-mega>
          <span class="flex items-center rounded-full transition-colors group-hover:bg-bd-green group-data-[open]:bg-bd-green">
            <a href={href(nav.main.servicesLink)} class="rounded-l-full py-2 pl-4 font-medium text-black">{nav.main.servicesLabel}</a>
            <button type="button" data-mega-trigger aria-expanded="false" aria-controls="mega-servizi" class="grid h-10 place-items-center rounded-r-full pr-3 pl-1 text-black">
              <span class="sr-only">{s.a11y.toggleServices}</span>
              <Icon name="chevron" size={16} stroke={2.5} class="transition-transform group-hover:rotate-180 group-data-[open]:rotate-180" />
            </button>
          </span>
          <MegaMenu g={g} />
        </li>
        {nav.main.items.map((it) => (
          <li><a href={href(it.link)} class="rounded-full px-4 py-2 font-medium text-black transition-colors hover:bg-gray-100">{it.label}</a></li>
        ))}
        <li class="ml-3"><a href={cta.href} class="btn-primary">{cta.label} <Icon name="arrow" size={20} /></a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      <a href={cta.href} class="grid h-12 w-12 place-items-center rounded-full bg-bd-green text-black" aria-label={s.a11y.toContacts}><Icon name="phone" size={22} /></a>
      <button type="button" data-mobile-toggle aria-expanded="false" aria-controls="mobile-menu" class="grid h-12 w-12 place-items-center rounded-full bg-black text-white">
        <span class="sr-only">{s.a11y.openMenu}</span><Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>
